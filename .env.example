# Copy to .env and fill in real values. .env is gitignored.

# Snowflake — programmatic access token auth (see resources.py / dbt/profiles.yml)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_TOKEN=
SNOWFLAKE_ROLE=SYSADMIN

# Free API keys
BLS_API_KEY=    # register at bls.gov
FRED_API_KEY=   # register at fred.stlouisfed.org
NEWS_API_KEY=   # newsapi.org — free tier covers last 30 days
